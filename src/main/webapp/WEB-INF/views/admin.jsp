<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Onewish team dashboard</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="nav"><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a><form method="post" action="${pageContext.request.contextPath}/admin/logout"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><button class="text-link">Sign out</button></form></header><main class="admin-page"><p class="eyebrow">ONEWISH TEAM</p><h1>Good morning, <em>team.</em></h1><c:if test="${not empty sessionScope.flash}"><p class="notice"><c:out value="${sessionScope.flash}"/></p><c:remove var="flash" scope="session"/></c:if><div class="stats"><article><span>Orders received</span><strong><c:out value="${stats[0]}"/></strong></article><article><span>Order value to date</span><strong>₹<c:out value="${stats[1]}"/></strong></article></div>
<section><h2>Orders</h2><form class="order-filters" method="get"><label>Status<select name="status"><option value="">All statuses</option><option <c:if test="${filterStatus eq 'PLACED'}">selected</c:if>>PLACED</option><option <c:if test="${filterStatus eq 'PREPARING'}">selected</c:if>>PREPARING</option><option <c:if test="${filterStatus eq 'READY'}">selected</c:if>>READY</option><option <c:if test="${filterStatus eq 'COMPLETED'}">selected</c:if>>COMPLETED</option><option <c:if test="${filterStatus eq 'CANCELLED'}">selected</c:if>>CANCELLED</option></select></label><label>Date<input type="date" name="date" value="<c:out value='${filterDate}'/>"></label><button class="button button-dark">Filter orders</button></form><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody><c:forEach items="${orders}" var="o"><tr><td><c:out value="${o[1]}"/></td><td><c:out value="${o[2]}"/></td><td>₹<c:out value="${o[4]}"/></td><td><c:out value="${o[3]}"/></td><td><form method="post"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="${o[0]}"><select name="status"><option>PLACED</option><option>PREPARING</option><option>READY</option><option>COMPLETED</option><option>CANCELLED</option></select><button class="text-link">Save</button></form></td></tr></c:forEach></tbody></table></div></section>
<section><h2>Add a menu item</h2><form class="form-card admin-form" method="post"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="action" value="item"><input type="hidden" name="id" value="0"><label>Name<input name="name" required maxlength="120"></label><label>Description<textarea name="description" required maxlength="1000"></textarea></label><label>Price in ₹<input name="price" type="number" min="0.01" step="0.01" required></label><label>Category<select name="category"><c:forEach items="${adminCategories}" var="c"><option value="${c[0]}"><c:out value="${c[1]}"/></option></c:forEach></select></label><label>Photo URL<input name="image" type="url" required placeholder="https://..."></label><label>Food type<select name="type"><option>VEG</option><option>NON_VEG</option><option>EGG</option></select></label><label class="check-label"><input type="checkbox" name="available" checked> Available</label><button class="button button-dark">Add menu item ↗</button></form></section>
<section><h2>Menu availability</h2><div class="table-wrap"><table><thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Available</th></tr></thead><tbody><c:forEach items="${items}" var="m"><tr><td colspan="4"><form class="admin-row" method="post"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="action" value="item"><input type="hidden" name="id" value="${m.id}"><input name="name" value="<c:out value='${m.name}'/>" required maxlength="120"><input name="description" value="<c:out value='${m.description}'/>" required maxlength="1000"><select name="category"><c:forEach items="${adminCategories}" var="c"><option value="${c[0]}" <c:if test="${c[0] eq m.categoryId}">selected</c:if>><c:out value="${c[1]}"/></option></c:forEach></select><input name="price" type="number" min="0.01" step="0.01" value="${m.price}" required><input name="image" type="url" value="<c:out value='${m.imageUrl}'/>" required><select name="type"><option <c:if test="${m.foodType eq 'VEG'}">selected</c:if>>VEG</option><option <c:if test="${m.foodType eq 'NON_VEG'}">selected</c:if>>NON_VEG</option><option <c:if test="${m.foodType eq 'EGG'}">selected</c:if>>EGG</option></select><label class="check-label"><input type="checkbox" name="available" <c:if test="${m.available}">checked</c:if>> Available</label><button class="text-link">Save item</button></form></td></tr></c:forEach></tbody></table></div></section></main></body></html>
