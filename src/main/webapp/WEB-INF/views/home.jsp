<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:if test="${pageContext.request.servletPath eq '/menu'}">Menu — </c:if>Onewish Cafe — good things take time</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"><script defer src="${pageContext.request.contextPath}/assets/app.js"></script></head><body>
<header class="nav"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">o</span>onewish<span class="brand-dot">.</span></a><nav><a href="${pageContext.request.contextPath}/menu">Menu</a><a href="${pageContext.request.contextPath}/about">Our story</a><a href="${pageContext.request.contextPath}/track">Track order</a><a href="${pageContext.request.contextPath}/contact">Contact</a></nav><a class="bag" href="${pageContext.request.contextPath}/cart">Your bag <span>↗</span></a></header>
<main><section class="hero"><div class="hero-copy"><p class="eyebrow"><i></i> YOUR NEIGHBOURHOOD CAFE</p><h1>Good things<br>take <em>time.</em></h1><p class="hero-sub">A little pause in your day, served just the way you like it. Fresh coffee, feel-good food, and a seat saved for you.</p><a class="button button-dark" href="${pageContext.request.contextPath}/menu">Explore the menu <span>↗</span></a><div class="hero-note"><span>✳</span> Made fresh, always. <b>·</b> Made with love, daily.</div></div><div class="hero-photo"><img src="https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1400&q=90" alt="A warm cup of coffee in a sunlit cafe"><div class="photo-tag"><span>EST. WITH LOVE</span><strong>One wish at a time.</strong></div><span class="hero-orbit">✳</span></div><span class="hero-index">01 <i></i> 04</span></section>
<section class="ticker"><div>GOOD COFFEE, GOOD COMPANY <span>✳</span> SOMETHING FOR EVERY MOOD <span>✳</span> MADE FRESH, EVERY DAY <span>✳</span> GOOD COFFEE, GOOD COMPANY <span>✳</span></div></section>
<section class="menu-section" id="menu"><div class="section-head"><div><p class="eyebrow"><c:choose><c:when test="${pageContext.request.servletPath eq '/menu'}">THE ONEWISH MENU</c:when><c:otherwise>A FEW CROWD FAVOURITES</c:otherwise></c:choose></p><h2>Made for your <em>kind of day.</em></h2></div><c:if test="${pageContext.request.servletPath ne '/menu'}"><a class="text-link" href="${pageContext.request.contextPath}/menu">See the full menu ↗</a></c:if></div><c:if test="${pageContext.request.servletPath eq '/menu'}"><form class="menu-filters" method="get" action="${pageContext.request.contextPath}/menu"><input name="q" type="search" placeholder="Search the menu" value="<c:out value='${param.q}'/>"><select name="category"><option value="">All categories</option><c:forEach items="${categories}" var="cat"><option value="<c:out value='${cat[0]}'/>"><c:out value="${cat[1]}"/></option></c:forEach></select><select name="sort"><option value="">Name</option><option value="price_asc">Price: low to high</option><option value="price_desc">Price: high to low</option></select><button class="button button-dark">Filter</button></form></c:if><c:if test="${not empty flash}"><p class="notice"><c:out value="${flash}"/></p></c:if><c:if test="${menuError}"><p class="notice">Our menu is taking a short break. Please try again soon.</p></c:if><div class="food-grid"><c:forEach items="${items}" var="item" varStatus="loop"><c:if test="${pageContext.request.servletPath eq '/menu' or loop.index lt 6}"><article class="food-card"><div class="food-image"><img src="<c:out value='${item.imageUrl}'/>" alt="<c:out value='${item.name}'/>" loading="lazy"><span class="food-type ${item.foodType eq 'VEG' ? 'veg' : 'nonveg'}"><i></i><c:out value="${item.foodType}"/></span></div><div class="food-info"><div><h3><a href="${pageContext.request.contextPath}/item?id=${item.id}"><c:out value="${item.name}"/></a></h3><p><c:out value="${item.description}"/></p></div><strong>₹<c:out value="${item.price}"/></strong></div><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="quantity" value="1"><button class="add-button" type="submit">Add to bag <span>+</span></button></form></article></c:if></c:forEach></div></section>
<section class="story" id="story"><div class="story-photo"><img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1100&q=85" alt="Coffee being poured at Onewish" loading="lazy"></div><div class="story-copy"><p class="eyebrow">A TABLE FOR EVERYONE</p><h2>Little moments.<br><em>Made better.</em></h2><p>Onewish began with a simple thought: the best parts of a day often happen around a table. So we make the coffee carefully, cook the food fresh, and leave room for one more.</p><a class="text-link" href="${pageContext.request.contextPath}/menu">Come find your favourite ↗</a></div></section></main>
<footer><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a><p>Thoughtfully made. Happily shared.</p><a href="${pageContext.request.contextPath}/contact">Contact</a><a href="${pageContext.request.contextPath}/admin/login">Team sign in</a><small>© 2026 Onewish Cafe</small></footer></body></html>
