<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your bag — Onewish</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="nav"><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a><nav><a href="${pageContext.request.contextPath}/menu">Menu</a></nav></header><main class="plain-page"><p class="eyebrow">YOUR ONEWISH ORDER</p><h1>Your <em>bag.</em></h1><c:choose><c:when test="${empty lines}"><p>Your bag is still waiting for something delicious.</p><a class="button button-dark" href="${pageContext.request.contextPath}/menu">Browse menu ↗</a></c:when><c:otherwise><div class="cart-list"><c:forEach items="${lines}" var="line"><div class="cart-line"><div><h3><c:out value="${line.item.name}"/></h3><p>₹<c:out value="${line.item.price}"/> each</p><form class="quantity-controls" method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="quantity"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="id" value="${line.item.id}"><button name="delta" value="-1" aria-label="Decrease quantity">−</button><span><c:out value="${line.quantity}"/></span><button name="delta" value="1" aria-label="Increase quantity">+</button></form></div><strong>₹<c:out value="${line.lineTotal}"/></strong><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="id" value="${line.item.id}"><button class="text-link">Remove</button></form></div></c:forEach></div><div class="cart-total"><span>Subtotal</span><strong>₹<c:out value="${total}"/></strong></div><p class="muted">Payment is collected at the cafe. Delivery availability depends on your location.</p><a class="button button-dark" href="${pageContext.request.contextPath}/checkout">Continue to checkout ↗</a></c:otherwise></c:choose></main></body></html>
