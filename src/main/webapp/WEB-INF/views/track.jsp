<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Track your order — Onewish</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="nav"><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a><nav><a href="${pageContext.request.contextPath}/menu">Menu</a></nav></header><main class="plain-page"><p class="eyebrow">A LITTLE UPDATE</p><h1>Track your <em>order.</em></h1><form class="form-card" method="get"><label>Order reference<input name="ref" placeholder="OW-32_HEX_CHARACTERS" required pattern="OW-[A-Fa-f0-9]{32}" value="<c:out value='${param.ref}'/>"></label><button class="button button-dark">Find my order ↗</button></form><c:choose><c:when test="${not empty order}"><div class="notice"><strong><c:out value="${order[0]}"/></strong> · <c:out value="${order[1]}"/><br>₹<c:out value="${order[2]}"/> · <c:out value="${order[4]}"/><br><span class="muted">Placed <c:out value="${order[3]}"/></span></div></c:when><c:when test="${not empty param.ref}"><p class="muted">We couldn't find that order reference.</p></c:when></c:choose></main></body></html>
