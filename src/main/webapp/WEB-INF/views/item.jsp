<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${item.name}"/> — Onewish</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="nav"><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a><nav><a href="${pageContext.request.contextPath}/menu">Menu</a><a href="${pageContext.request.contextPath}/about">Our story</a></nav><a class="bag" href="${pageContext.request.contextPath}/cart">Your bag ↗</a></header><main class="item-detail"><img src="<c:out value='${item.imageUrl}'/>" alt="<c:out value='${item.name}'/>"><div><p class="eyebrow"><c:out value="${item.category}"/></p><h1><c:out value="${item.name}"/></h1><p><c:out value="${item.description}"/></p><strong>₹<c:out value="${item.price}"/></strong><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="id" value="${item.id}"><label>Quantity <input type="number" name="quantity" min="1" max="20" value="1"></label><button class="button button-dark">Add to bag ↗</button></form></div></main></body></html>
