<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Checkout — Onewish</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="nav"><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a></header><main class="plain-page"><p class="eyebrow">ALMOST THERE</p><h1>Make it <em>yours.</em></h1><form class="form-card" method="post"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><label>Your name<input name="name" required minlength="2" maxlength="100" autocomplete="name"></label><label>Phone number<input name="phone" required pattern="[+0-9 ()-]{8,20}" autocomplete="tel"></label><label>How would you like it?<select name="fulfilment"><option value="pickup">Pick up at the cafe</option><option value="delivery">Delivery</option></select></label><label>Delivery address<textarea name="address" maxlength="500" minlength="8" data-delivery-address></textarea></label><p class="muted">Pay at the counter on pickup or delivery. No online payment is collected.</p><button class="button button-dark" type="submit">Place order ↗</button></form></main><script>document.querySelector('[name=fulfilment]').addEventListener('change',e=>{const a=document.querySelector('[data-delivery-address]');a.required=e.target.value==='delivery';a.disabled=!a.required})</script></body></html>
