<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact — Onewish</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="nav"><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a><nav><a href="${pageContext.request.contextPath}/menu">Menu</a><a href="${pageContext.request.contextPath}/about">Our story</a></nav></header><main class="plain-page"><p class="eyebrow">WE'D LOVE TO HEAR FROM YOU</p><h1>Say <em>hello.</em></h1><c:if test="${not empty flash}"><p class="notice"><c:out value="${flash}"/></p></c:if><form class="form-card" method="post"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><label>Your name<input name="name" required minlength="2" maxlength="100"></label><label>Email<input name="email" type="email" required maxlength="190"></label><label>Your note<textarea name="message" required minlength="10" maxlength="2000"></textarea></label><button class="button button-dark">Send your note ↗</button></form></main></body></html>
