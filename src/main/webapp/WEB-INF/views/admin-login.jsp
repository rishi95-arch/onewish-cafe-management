<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Team sign in — Onewish</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><main class="plain-page"><a class="brand" href="${pageContext.request.contextPath}/">onewish<span class="brand-dot">.</span></a><p class="eyebrow">ONEWISH TEAM</p><h1>Good to have <em>you back.</em></h1><c:if test="${not empty sessionScope.flash}"><p class="notice"><c:out value="${sessionScope.flash}"/></p><c:remove var="flash" scope="session"/></c:if><form class="form-card" method="post"><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><label>Email<input type="email" name="email" required autocomplete="username"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button class="button button-dark">Sign in ↗</button></form></main></body></html>
